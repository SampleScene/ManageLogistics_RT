 @using ManageLogistics_RT.Data.Enum
@using ManageLogistics_RT.ViewModels.Employee;
@model CreateEmployeeViewModel;

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}


<div class="row">
    <div class="col-md-6 offset-3">


        <div class="row">

            <div class="col-md-8 offset-2">
                <form method="post" asp-action="CreateEmployee" enctype="multipart/form-data">
                    <p>
                        <h4>Создание сотрудника</h4>
                    </p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="col-md-12 alert alert-danger mb-3">
                            <span><b>Извените!</b> - @TempData["Error"] </span>
                        </div>
                    }
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="EmailAddress" class="control-label">Адрес электронной почты</label>
                        <input asp-for="EmailAddress" class="form-control" placeholder="Введите адрес электронной почты" />
                        <span asp-validation-for="EmailAddress" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="TerminalId" class="control-label">Id термминал</label>
                        <input asp-for="TerminalId" class="form-control" placeholder="Введите id терминала" />
                        <span asp-validation-for="TerminalId" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="FirstName" class="control-label">Имя</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Введите имя сотрудника" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="LastName" class="control-label">Фамилия</label>
                        <input asp-for="LastName" class="form-control" placeholder="Введите фамилию сотрудника" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="SerialAndNumber" class="control-label">Серия и номер</label>
                        <input asp-for="SerialAndNumber" class="form-control" placeholder="Введите серию и номер" />
                        <span asp-validation-for="SerialAndNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="IssuedBy" class="control-label">Кем выдан</label>
                        <input asp-for="IssuedBy" class="form-control" placeholder="Введите кем выдан" />
                        <span asp-validation-for="IssuedBy" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Roles" class="form-label">Роль</label>
                        <select asp-for="Roles" asp-items="@Html.GetEnumSelectList<EmployeeRoles>()" class="form-control">
                            <option>--Выберите--</option>
                        </select>
                        <span asp-validation-for="Roles" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Password" class="control-label">Пароль</label>
                        <input asp-for="Password" class="form-control" placeholder="Введите пароль" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="ConfirmPassword" class="control-label">Подтверждение пароля</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Подтвердите пароль" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Image" class="control-label">Фото</label>
                        <input asp-for="Image" class="form-control" placeholder="Вставьте фото" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <input class="btn btn-outline-success float-right" type="submit" value="Зарегестрироваться" />
                        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Вернутся</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>