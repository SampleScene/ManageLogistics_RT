@model List<Employee>;


@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container">
    <div class="dashboard-content px-3 pt-4">

        <button type="button" class="btn btn-dark"><a asp-controller="Employee" asp-action="CreateEmployee" class="link-light link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" style="text-decoration:none">Добавить сотрудника</a></button>

        <h2 class="mb-3">Сотрудники</h2>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Имя</th>
                    <th scope="col">Фамилия</th>
                    <th scope="col">Терминал</th>
                    <th scope="col">Серия и номер</th>
                    <th scope="col">Кем выдан</th>
                    <th scope="col">Действие</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">@item.EmployeeId</th>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.TerminalId</td>
                        <td>@item.SerisesAndNumber</td>
                        <td>@item.IssuedBy</td>
                        @if (User.Identity.IsAuthenticated && (User.IsInRole("globaladmin") || User.IsInRole("admin")))
                        {
                            <td><a asp-controller="Employee" asp-action="EditEmployee" asp-route-id="@item.EmployeeId">Изменить</a></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>