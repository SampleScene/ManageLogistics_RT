@using ManageLogistics_RT.ViewModels.UserDashboard;
@model EditUserProfileViewModel;

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class=" px-3 pt-4" style="max-width: 600px;">
    <div class="dashboard-content px-3 pt-4">
        <p class="fs-5"> Текущее фото профиля</p>
        <div style=" max-width: 165px; max-height: 165px;">
            <img class="card-img-top" src="@Model.URL" width="165" height="165" style=" border-radius:50%;">
        </div>
        <!--
        <p>Model.Id</p>
        <p>Model.Image</p>
        <p>Model.FirstName</p>
        <p>Model.LastName</p>
        <p>Model.UserAuthData.Email</p>
        <p>Model.UserAuthData.UserName</p>-->
    </div>
    <br/>
  
    <form method="post" asp-action="EditUserProfile" enctype="multipart/form-data">
        <input type="hidden" id="Id" name="Id" asp-for="Id" />
        <div class="form-group mb-2">
            <label asp-for="FirstName">Фамилия</label>
            <input asp-for="FirstName" class="form-control" placeholder="Фамилия">
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-2">
            <label asp-for="LastName">Имя</label>
            <input asp-for="LastName" class="form-control" placeholder="Имя">
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Birthday">Дата рождения</label>
            <input asp-for="Birthday" class="form-control" placeholder="Введите дату рождения">
            <span asp-validation-for="Birthday" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Balance">Текущий баланс</label>
            <input asp-for="Balance" class="form-control" placeholder="Введите желаемый баланс">
            <span asp-validation-for="Balance" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Image" class="form-label">Новое фото профиля</label>
            <input asp-for="Image" type="file" class="form-control" placeholder="Image">
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Изменить</button>
    </form>
</div>

