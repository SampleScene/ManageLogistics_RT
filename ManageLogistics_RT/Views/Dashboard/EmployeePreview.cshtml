@model Employee

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}



<div class=" px-3 pt-4" style="max-width: 600px;">

    <div class="dashboard-content px-3 pt-4">
        <p class="fs-5">Терминал - @Model.Terminal.Title </p>
    </div>
    <br /> 
  
    <form method="post" asp-action="EditUserProfile" enctype="multipart/form-data">
        <input type="hidden" id="Id" name="Id" asp-for="EmployeeId" />
        <div class="form-group mb-2">
            <label asp-for="FirstName">Фамилия</label>
            <input asp-for="FirstName" class="form-control" placeholder="Фамилия" readonly>
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="LastName">Имя</label>
            <input asp-for="LastName" class="form-control" placeholder="Имя" readonly>
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="SerisesAndNumber">Серия и номер паспорта</label>
            <input asp-for="SerisesAndNumber" class="form-control" placeholder="" readonly>
            <span asp-validation-for="SerisesAndNumber" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="IssuedBy">Выдан</label>
            <input asp-for="IssuedBy" class="form-control" placeholder="" readonly>
            <span asp-validation-for="IssuedBy" class="text-danger"></span>
        </div>
    </form>
</div>