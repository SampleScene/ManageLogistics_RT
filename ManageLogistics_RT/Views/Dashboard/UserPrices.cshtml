<div class="container">
    <div class="dashboard-content px-3 pt-4">
            <button type="button" class="btn btn-dark"><a asp-controller="Price" asp-action="PriceList" class="link-light link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" style="text-decoration:none">Купить проездной</a></button>
            <br />
            <br />

        <!--<h2 class="fs-5">Ваши проездные</h2>-->

        <h3 class="fs-5 mb-3">Количественные</h3>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Название</th>
                    <th scope="col">Тип</th>
                    <th scope="col">Стоимость</th>
                    <th scope="col">Время действия</th>
                    <th scope="col">Осталось поездок</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.userPrices)
                {
                    @if(item.Time == null){
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.Title</td>
                            <td>@item.Type</td>
                            <td>@item.Fare</td>
                            <td>@item.Time</td>
                            @if (item.Number <= 0)
                            {
                                <td style="color:red;">Недействителен</td>
                            }
                            else
                            {
                                <td>@item.Number</td>
                            }
                        </tr>
                    }              
                }
            </tbody>
        </table>
        
        <h3 class="fs-5 mb-3">Временные</h3>
        
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Название</th>
                    <th scope="col">Тип</th>
                    <th scope="col">Стоимость</th>
                    <th scope="col">Время действия</th>
                    <th scope="col">Осталось поездок</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.userPrices)
                {
                    @if (item.Time != null)
                    {
                       
                        
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.Title</td>
                            <td>@item.Type</td>
                            <td>@item.Fare</td>

                            @if(item.Time <= -1){
                                <td style="color:red;">Недействителен</td>
                            }
                            else
                            {
                                <td>@item.Time</td>
                            }
                            <td>@item.Number</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>
</div>