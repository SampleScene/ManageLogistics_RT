@model IEnumerable<Trip>;

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}


<div class="container">
    <div class="dashboard-content px-3 pt-4">

        <button type="button" class="btn btn-dark"><a asp-controller="Trip" asp-action="Create" class="link-light link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" style="text-decoration:none">Добавить запись</a></button>


            <h2 class="mb-3">Распиание</h2>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Водитель</th>
                        <th scope="col">Маршрут</th>
                        <th scope="col">Автобус</th>
                        <th scope="col">Начало</th>
                        <th scope="col">Окончание</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.DriverId</td>
                            <td>@item.RouteId</td>
                            <td>@item.BusId</td>
                            <td>@item.TimeStart</td>
                            <td>@item.TimeEnd</td>
                            @if (User.Identity.IsAuthenticated && User.IsInRole("user"))
                            {
                                //<td><a asp-controller="Price" asp-action="Buy" asp-route-id="@price.Id">Купить</a></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
    </div>
</div>
