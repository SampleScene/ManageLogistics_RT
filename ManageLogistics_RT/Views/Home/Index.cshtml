@{
    ViewData["Title"] = "Home Page";
}

<!doctype html>
<html lang="en" data-bs-theme="auto">
<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

</head>

<body>
    <main>
        <div class="px-3 align-self-center" style="height:100vh; display:grid; grid-template-columns:0.5fr; align-items:center;  justify-content:space-around">
            <div style="text-align:center">
                <h1 class="font-weight-bold display-1">UrbanTrail</h1>
                <h2 class="display-3">Управляйте своим временем вместе с нами</h2>
                <p class="lead">
                    <!--<a href="#" class="btn btn-lg btn-light fw-bold border-white bg-white">Learn more</a>-->
                </p>
            </div>
        </div>

        <hr class="featurette-divider">
       
        <div class="" style="padding-bottom:44px;">
            <div class="row featurette">
                <div class="col-md-7">
                    <h2 class="featurette-heading fw-normal lh-1"><span class="text-body-secondary">Преимущества</span></h2>
                    <p class="lead">Опыт и профессионализм: наша команда имеет многолетний опыт работы в сфере маршрутных перевозок, что позволяет нам предоставлять качественные услуги. </p>
                </div>
                <div class="col-md-5">
                    <img class="bd-placeholder-img bd-placeholder-img-lg featurette-image img-fluid mx-auto" width="500" height="500" src="image/advantage500x500.jpg" role="img" aria-label="Placeholder: 500x500" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Placeholder</title><rect width="100%" height="100%" fill="var(--bs-secondary-bg)" /><!--<text x="50%" y="50%" fill="var(--bs-secondary-color)" dy=".3em">500x500</text>--></img>
                </div>
            </div>
            
            <hr class="featurette-divider">
            
            <div class="row featurette">
                <div class="col-md-7 order-md-2">
                    <h2 class="featurette-heading fw-normal lh-1"> <span class="text-body-secondary">Безопасность</span></h2>
                    <p class="lead">Мы обеспечиваем строгое соблюдение всех норм и правил безопасности, что гарантирует комфорт и безопасность пассажиров.</p>
                </div>
                <div class="col-md-5 order-md-1">
                    <img class="bd-placeholder-img bd-placeholder-img-lg featurette-image img-fluid mx-auto" width="500" height="500" src="image/security500X500.jpg" role="img" aria-label="Placeholder: 500x500" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Placeholder</title><rect width="100%" height="100%" fill="var(--bs-secondary-bg)" /><!--<text x="50%" y="50%" fill="var(--bs-secondary-color)" dy=".3em">500x500</text>--></img>
                </div>
            </div>
            
            <hr class="featurette-divider">

            <div class="row featurette">
                <div class="col-md-7">
                    <h2 class="featurette-heading fw-normal lh-1"> <span class="text-body-secondary">Услуги</span></h2>
                    <p class="lead">Маршрутно-транспортная компания предлагает полный спектр услуг по организации пассажирских перевозок, обеспечивая безопасность, комфорт и удобство.</p>
                </div>
                <div class="col-md-5">
                    <img class="bd-placeholder-img bd-placeholder-img-lg featurette-image img-fluid mx-auto" width="500" height="500" src="image/services500X500.jpg" role="img" aria-label="Placeholder: 500x500" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Placeholder</title><rect width="100%" height="100%" fill="var(--bs-secondary-bg)" /><!--<text x="50%" y="50%" fill="var(--bs-secondary-color)" dy=".3em">500x500</text>--></img>
                </div>
            </div>
            <br />
        </div>
    </main>
    
    

    

</body>
</html>