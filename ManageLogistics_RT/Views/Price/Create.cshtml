@using ManageLogistics_RT.Data.Enum;
@model Price;
@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}



<form method="post" asp-action="Create">
    <div class="mb-3">
        <label asp-for="Title" class="form-label">Название</label>
        <input asp-for="Title" class="form-control" placeholder="введите стоимость">
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label">Type</label>
        <select asp-for="Type" asp-items="@Html.GetEnumSelectList<TypePrice>()" class="form-control">
            <option>--Выберите--</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Fare" class="form-label">Стоимость</label>
        <input asp-for="Fare" class="form-control" placeholder="Введите стоимость">
        <span asp-validation-for="Fare" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Time" class="form-label">Время</label>
        <input asp-for="Time" class="form-control" placeholder="Введите время">
        <span asp-validation-for="Time" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Number" class="form-label">Кол-во поездок</label>
        <input asp-for="Number" class="form-control" placeholder="Введите количество">
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
    </div>
    <button type="submit" class="btn btn-primary">Создать</button>
</form>