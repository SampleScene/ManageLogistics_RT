@using ManageLogistics_RT.Data.Enum;
@model IEnumerable<Price>


@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<button type="button" class="btn btn-dark"><a asp-controller="Price" asp-action="Create" class="link-light link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" style="text-decoration:none">Добавить</a></button>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Название</th>
            <th scope="col">Тип</th>
            <th scope="col">Стоимость</th>
            <th scope="col">Время действия</th>
            <th scope="col">Кол-во поездок</th>
            @if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("globaladmin") || User.IsInRole("logistician")))
            {
                <th scope="col">Действия</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Title</td>
                <td>@item.Type</td>
                <td>@item.Fare</td>
                <td>@item.Time</td>
                <td>@item.Number</td>
                @if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("globaladmin") || User.IsInRole("logistician")))
                {
                    <td><a asp-controller="Price" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                }
            </tr>
        }
    </tbody>
</table>