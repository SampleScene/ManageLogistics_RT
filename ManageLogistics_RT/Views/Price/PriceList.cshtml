@using ManageLogistics_RT.ViewModels.PriceVM;
@model PriceListViewModel;

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}



<div class="container">
    <div class="dashboard-content px-3 pt-4">

        @if (Model.errorMessage != null)
        {
            <h2 style="color:#dc3545" class="mb-3">@Model.errorMessage</h2>
        }
       
        @foreach (var terminal in Model.terminals)
        {
            <h2 class="mb-3">Город: @terminal.City</h2>
            <h2 class="mb-3">Терминал: @terminal.Title</h2>
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Название</th>
                        <th scope="col">Тип</th>
                        <th scope="col">Стоимость</th>
                        <th scope="col">Время действия</th>
                        <th scope="col">Кол-во поездок</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var price in Model.prices)
                    {
                        <tr>
                            <th scope="row">@price.Id</th>
                            <td>@price.Title</td>
                            <td>@price.Type</td>
                            <td>@price.Fare</td>
                            <td>@price.Time</td>
                            <td>@price.Number</td>
                            @if (User.Identity.IsAuthenticated && User.IsInRole("user"))
                            {
                                <td><a asp-controller="Price" asp-action="Buy" asp-route-id="@price.Id">Купить</a></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>