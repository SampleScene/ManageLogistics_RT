@model IEnumerable<Bus>

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<button type="button" class="btn btn-dark"><a asp-controller="Bus" asp-action="Create" class="link-light link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" style="text-decoration:none">Добавить</a></button>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Модель</th>
            <th scope="col">Вместимость</th>
            <th scope="col">Статус</th>
            @if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("globaladmin") || User.IsInRole("logistician")))
            {
                <th scope="col">Действия</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Model</td>
                <td>@item.Capacity</td>
                <td>@item.Status</td>
                @if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("globaladmin") || User.IsInRole("logistician")))
                {
                    <td><a asp-controller="Price" asp-action="Edit" asp-route-id="@item.Id">Edit</a> / <a>Delete</a></td>
                }
            </tr>
        }
    </tbody>
</table>