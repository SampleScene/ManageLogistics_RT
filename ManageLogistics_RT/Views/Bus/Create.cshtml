@model Bus;

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<form method="post" asp-action="Create" enctype="multipart/form-data">
    <input type="hidden" value="TerminalId" id="TerminalId" />

    <div class="mb-3">
        <label asp-for="TerminalId" class="form-label">Терминал</label>
        <input asp-for="TerminalId" class="form-control" placeholder="Терминал" readonly>
        <span asp-validation-for="TerminalId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label">Модель</label>
        <input asp-for="Model" class="form-control" placeholder="Модель">
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Capacity" class="form-label">Вместимость</label>
        <input asp-for="Capacity" class="form-control" placeholder="Вместимость">
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>
    
    <div class="mb-3 form-check">
    </div>
    <button type="submit" class="btn btn-primary">Создать</button>
</form>
