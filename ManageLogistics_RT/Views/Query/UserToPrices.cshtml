@using ManageLogistics_RT.ViewModels.UserQuery;
@model UserToPriceViewModel;

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}





<div style="display: flex; justify-content: center;">

    <div style="width: 14%; height: 100px; text-align:center">
        <p>Билетов</p>@if (Model.ticketCount != null)
        {
            <p>@Model.ticketCount </p>
        }
        else
        {
            <p>0</p>
        }
    </div>

    <div style="width: 14%; height: 100px; text-align:center">
        <p>Проездных</p> @if (Model.travelCardCount != null)
        {
            <p>@Model.travelCardCount </p>
        }
        else
        {
            <p>0</p>
        }
    </div>

    <div style="width: 14%; height: 100px; text-align:center">
        <p>Всего</p> @if (Model.allTrips != null)
        {
            <p>@Model.allTrips </p>
        }
        else
        {
            <p>0</p>
        }
    </div>

</div>

<form style="width:50%; display:flex; margin:auto; align-items:center; justify-content:space-between; min-width: 350px;" method="post" asp-action="UserToPrices" enctype="multipart/form-data">
    <div class="" style="width:100%; padding:0; margin-right:5px;">
        <input  asp-for="Query" class="form-control"  placeholder="Введите дату 'xxxx-xx-xx' или номер билета">
        <span asp-validation-for="Query" class="text-danger"></span>
    </div>
    <div class="" style="text-align:center">
        <button type="submit" class="btn btn-primary" style="margin-left:auto; margin-right:auto;">Поиск</button>
    </div>
</form>

<div class="container">
    <div class="dashboard-content px-8 pt-4">

        @if (Model.tripReceipts != null)
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">Номер билета</th>
                        <th scope="col">Номер проездного</th>
                        <th scope="col">Дата</th>
                        <th scope="col">Тип операци</th>
                        <th scope="col">Маршрут</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.tripReceipts)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.PassId</td>
                            <td>@item.DateOfoperation</td>
                            <td>@item.Operation</td>
                            <td>@item.TripId</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>нет данных</p>
        }

    </div>
</div>