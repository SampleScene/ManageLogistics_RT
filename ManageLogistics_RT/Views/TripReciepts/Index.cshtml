@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}


<html>

<head>
    <meta name="viewport" content="width-device-width, initial-scale=1.0">
</head>

<style>
    main {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    #reader {
        width: 600px;
    }

    #result {
        text-align: center;
        font-size: 1.5rem;
    }
</style>

<main>
    <div id="reader"></div>
    <div id="result"></div>
</main>

</html>

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<!--<script src="qr-scanerJS/node_modules/html5-qrcode/html5-qrcode.min.js"> -->

<script>


    const scanner = new Html5QrcodeScanner('reader', {
        qrbox: {
            width: 250,
            height: 250,
        },
        fps: 20,
    });
    
    scanner.render(success, error);

    function success(result) {
        window.location.href = `http://urbantrail.azurewebsites.net/TripReciepts/Buy/${result}`
        document.getElementById('result').innerHTML = `
            <h2>Success!</h2>
            <p>${result}</p>
            `;
        scanner.clear();
        document.getElementById('reader').remove();

        console.log(result);
    }

    function error(error) {
        console.error(error);
    }
</script>