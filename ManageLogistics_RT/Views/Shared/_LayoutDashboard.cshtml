<!DOCTYPE html>

<html>
<head>

    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ManageLogistics_RT.styles.css" asp-append-version="true" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
</head>

<style>
    .btn-outline-success {
        color: #5C9674;
        border-color: #5C9674;
    }

        .btn-outline-success:hover {
            color: #fff;
            background-color: #5C9674;
            border-color: #5C9674;
        }

        .btn-check:focus + .btn-outline-success, .btn-outline-success:focus {
            box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.5);
        }

        .btn-check:checked + .btn-outline-success, .btn-check:active + .btn-outline-success, .btn-outline-success:active, .btn-outline-success.active, .btn-outline-success.dropdown-toggle.show {
            color: #fff;
            background-color: #5C9674;
            border-color: #5C9674;
        }

            .btn-check:checked + .btn-outline-success:focus, .btn-check:active + .btn-outline-success:focus, .btn-outline-success:active:focus, .btn-outline-success.active:focus, .btn-outline-success.dropdown-toggle.show:focus {
                box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.5);
            }

        .btn-outline-success:disabled, .btn-outline-success.disabled {
            color: #5C9674;
            background-color: transparent;
        }
</style>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ManageLogistics_RT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="About">О нас</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Stop" asp-action="Index">Остановки</a>
                        </li>
                        
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("globaladmin") || User.IsInRole("logistician")))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="EmployeePreview">Dashboard</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="UserQR">Dashboard</a>
                                </li>
                            }
                            <li class="nav-item">
                                <button class="btn btn-outline-danger"><a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">Выход</a></button>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <button class="btn btn-outline-success"><a class="nav-link text-dark " asp-area="" asp-controller="Account" asp-action="Login">Логин</a></button>
                            </li>
                            <li class="nav-item">
                                <button class="btn btn-outline-secondary"><a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Регистрация</a></button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-container d-flex">
        <div class="sidebar" id="side_nav">
            <div class="header-box px-2 pt-3 pb-4 d-flex justify-content-between">
                <h1 class="fs-4">
                        <span class="bg-white text-dark rounded shadow px-2 me-2">ML</span> <span class="text-white">Опции</span>
                </h1>
                <button class="btn d-md-none d-block close-btn px-1 py-0 text-white">
                    <i class="fal fa-stream"></i>
                </button>
            </div>
            
            <ul class="list-unstyled px-2"> 
                @if (User.Identity.IsAuthenticated && User.IsInRole("globaladmin"))
                {
                    
                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Dashboard" asp-action="EmployeePreview"> <i class="fal fa-home"></i>Dashboard</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Bus" asp-action="Index"> <i class="fal fa-home"></i>Автобусы</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Trip" asp-action="AllTrip"><i class="fal fa-home"></i>Расписаниe</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Employee" asp-action="EmployeeList"><i class="fal fa-home"></i>Сотрурдники</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="TripReciepts" asp-action="Index"><i class="fal fa-home"></i>Тeриминал оплаты</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Query" asp-action="UserToPrices"><i class="fal fa-home"></i>Билеты</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Price" asp-action="Index"><i class="fal fa-home"></i>Проездные</a></li>

                }
                
                @if (User.Identity.IsAuthenticated && User.IsInRole("admin"))
                {
                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Dashboard" asp-action="EmployeePreview"> <i class="fal fa-home"></i>Профиль</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Bus" asp-action="Index"> <i class="fal fa-home"></i>Автобусы</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Trip" asp-action="AllTrip"><i class="fal fa-home"></i>Расписаниe</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Employee" asp-action="EmployeeList"><i class="fal fa-home"></i>Сотрурдники</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="TripReciepts" asp-action="Index"><i class="fal fa-home"></i>Тeриминал оплаты</a></li>
                }
                
                @if (User.Identity.IsAuthenticated && User.IsInRole("logistician"))
                {
                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Dashboard" asp-action="EmployeePreview"> <i class="fal fa-home"></i>Профиль</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Bus" asp-action="Index"> <i class="fal fa-home"></i>Автобусы</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Trip" asp-action="AllTrip"><i class="fal fa-home"></i>Расписаниe</a></li>
                }

                @if (User.Identity.IsAuthenticated && User.IsInRole("driver"))
                {
                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Dashboard" asp-action="EmployeePreview"> <i class="fal fa-home"></i>Профиль</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="TripReciepts" asp-action="Index"><i class="fal fa-home"></i>Тeриминал оплаты</a></li>
                }
           
                @if (User.Identity.IsAuthenticated && User.IsInRole("user"))
                {

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Dashboard" asp-action="UserQR"><i class="fal fa-home"></i>QRCode</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Dashboard" asp-action="UserPrices"><i class="fal fa-home"></i>Мои проездные</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="TripReciepts" asp-action="UserTripReciepts"><i class="fal fa-home"></i>Мои поездки</a></li>

                    <li class=""><a class="text-decoration-none px-3 py-2 d-block" asp-area="" asp-controller="Dashboard" asp-action="EditUserProfile"><i class="fal fa-list"></i>Профиль</a></li>
                }

                <!--
                <li class="">
                    <a href="#" class="text-decoration-none px-3 py-2 d-block d-flex justify-content-between">
                        <span><i class="fal fa-comment"></i> Messages</span>
                        <span class="bg-dark rounded-pill text-white py-0 px-2">02</span>
                    </a>
                </li>-->
                
            </ul>

            <hr class="h-color mx-2">

           @*  <ul class="list-unstyled px-2">
                <li class="">
                    <a href="#" class="text-decoration-none px-3 py-2 d-block">
                        <i class="fal fa-bars"></i>
                        Settings
                    </a>
                </li>
                <li class="">
                    <a href="#" class="text-decoration-none px-3 py-2 d-block">
                        <i class="fal fa-bell"></i>
                        Notifications
                    </a>
                </li>

            </ul> *@

        </div>
        <div class="content">
            <!--
                        <nav class="navbar navbar-expand-md navbar-light bg-light">
                            <div class="container-fluid">
                                <div class="d-flex justify-content-between d-md-none d-block">
                                 <button class="btn px-1 py-0 open-btn me-2"><i class="fal fa-stream"></i></button>
                                    <a class="navbar-brand fs-4" href="#"><span class="bg-dark rounded px-2 py-0 text-white">CL</span></a>

                                </div>
                                <button class="navbar-toggler p-0 border-0" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                                    aria-expanded="false" aria-label="Toggle navigation">
                                    <i class="fal fa-bars"></i>
                                </button>
                                <div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">
                                    <ul class="navbar-nav mb-2 mb-lg-0">
                                        <li class="nav-item">
                                            <a class="nav-link active" aria-current="page" href="#">Profile</a>
                                        </li>

                                    </ul>

                                </div>
                            </div>
                        </nav>
            -->
            <div>
                @RenderBody()
            </div>
            
           
        </div>    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - ManageLogistics_RT - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"/></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>