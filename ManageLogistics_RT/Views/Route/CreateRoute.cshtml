@using ManageLogistics_RT.ViewModels.Route;
@model CreateRouteViewModel;

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div style="display: flex;">

    <div style=" display: inline-block; border: 1px solid black; margin: 2px; width: 50%">
        <ul class="list-group">
            @foreach (var item in Model.stops)
            {
                <li onclick="btn_click()" id="stop1" class="list-group-item"><img src="@item.Image" width="40" height="40"> <p>@item.City , @item.Street , @item.Home</p>  </li>

            }
        </ul>
    </div>
   
    <div style=" display: inline-block; border: 1px solid black;margin: 2px; width: 50%">
        
        <h1>Маршрут</h1>
        <br />
        <ul id="createdRoute" class="list-group">
           
        </ul>
    </div >
</div>
