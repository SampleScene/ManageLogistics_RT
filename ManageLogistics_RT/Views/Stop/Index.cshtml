@using ManageLogistics_RT.ViewModels;
@model IEnumerable<StopViewModel>;

<section class="py-5 text-center container">
    <div class="row py-lg-5">
        <div class="col-lg-6 col-md-8 mx-auto">
            <h1 class="fw-light">Список остановок</h1>
            @if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("globaladmin") || User.IsInRole("logistician")))
            {
                <p class="lead text-body-secondary">Доступные операции</p>
                <p>
                    <a asp-controller="Stop" asp-action="Create" class="btn btn-primary my-2">Создать запсиь</a>
                </p>
            }
        </div>
    </div>
</section>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
   
    @foreach(var item in Model)
    {
        <div class="col">
           <div class="card shadow-sm">
              <img class="card-img-top" src="@item.Image">              
              <div class="card-body">
                  <p class="card-text">Город: @item.City </p>
                    <p class="card-text">Улица: @item.Street</p>
                    <p class="card-text">Дом: @item.Home</p>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group">
                            <!--<button type="button" class="btn btn-sm btn-outline-secondary">View</button>-->
                            @if (User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("globaladmin") || User.IsInRole("logistician")))
                       {
                                <a asp-controller="Stop" asp-action="Edit" asp-route-id="@item.Id" type="button" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-controller="Stop" asp-action="Delete" asp-route-id="@item.Id" type="button" class="btn btn-sm btn-outline-secondary">Delete</a>
                       }
                    </div>
                        <!--<small class="text-body-secondary"></small>-->
                  </div>
              </div>
           </div>
        </div>
     }
</div>

