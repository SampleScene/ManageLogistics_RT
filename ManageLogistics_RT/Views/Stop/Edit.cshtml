@using ManageLogistics_RT.ViewModels;
@model EditStopViewModel;

<form method="post" asp-action="Edit" enctype="multipart/form-data">
    <input type="hidden" value="Id" id="Id"/>
    <div class="mb-3">
        <label asp-for="City" class="form-label">City</label>
        <input asp-for="City" class="form-control" placeholder="City">
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Street" class="form-label">Street</label>
        <input asp-for="Street" class="form-control" placeholder="Street">
        <span asp-validation-for="Street" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Home" class="form-label">Home</label>
        <input asp-for="Home" class="form-control" placeholder="Home">
        <span asp-validation-for="Home" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Image" class="form-label">Image</label>
        <input asp-for="Image" type="file" class="form-control" placeholder="Image">
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
