@using ManageLogistics_RT.ViewModels;
@model CreateStopViewModel;



<form method="post" asp-action="Create" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="City" class="form-label">Город</label>
        <input asp-for="City"  class="form-control" placeholder="Введите город"  >
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Street" class="form-label">Улица</label>
        <input asp-for="Street" class="form-control" placeholder="Введите улицу" >
        <span asp-validation-for="Street" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Home" class="form-label">Дом</label>
        <input asp-for="Home" class="form-control" placeholder="Введите дом">
        <span asp-validation-for="Home" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Image" class="form-label">Изображение</label>
        <input asp-for="Image" type="file" class="form-control" placeholder="Вставьте изображение">
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>
    
    <div class="mb-3 form-check">
    </div>
    <button type="submit" class="btn btn-primary">Создать</button>
</form>

